<UserControl x:Class="StoreOwnerApplication.Frames.OrderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StoreOwnerApplication.Frames"
             mc:Ignorable="d" 
             Height="450" Width="800">
    <Grid Background="#F5F5F5" Margin="60,0,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->

        <TextBlock Text="Orders List"
               FontWeight="Bold"
               FontSize="34"
               HorizontalAlignment="Center"
               Margin="0,20,0,20"
               Foreground="#222"/>

        <!-- Headers -->

        <Border Grid.Row="1"
            Background="#ECECEC"
            CornerRadius="8"
            Margin="30,0,30,10"
            Padding="12">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="100"/>

                    <ColumnDefinition Width="150"/>

                    <ColumnDefinition Width="250"/>

                    <ColumnDefinition Width="100"/>

                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                       Text="Order Id"
                       FontWeight="Bold"
                       FontSize="15"/>

                <TextBlock Grid.Column="1"
                       Text="Client Id"
                       FontWeight="Bold"
                       FontSize="15"/>

                <TextBlock Grid.Column="2"
                       Text="Order Date"
                       FontWeight="Bold"
                       FontSize="15"/>

                <TextBlock Grid.Column="3"
                       Text="Paid"
                       FontWeight="Bold"
                       FontSize="15"/>

            </Grid>

        </Border>

        <!-- Orders -->

        <ListView x:Name="OrdersListView"
              Grid.Row="2"
              Margin="30,0,30,20"
              BorderThickness="0"
              Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemContainerStyle>

                <Style TargetType="ListViewItem">

                    <Setter Property="Margin" Value="0,0,0,10"/>

                    <Setter Property="BorderThickness" Value="0"/>

                    <Setter Property="Padding" Value="0"/>

                </Style>

            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border Background="White"
                        CornerRadius="10"
                        Padding="15"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="100"/>

                                <ColumnDefinition Width="150"/>

                                <ColumnDefinition Width="250"/>

                                <ColumnDefinition Width="100"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                   Text="{Binding OrderId}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                   Text="{Binding ClientId}"
                                   FontSize="14"
                                   Foreground="#555"
                                   VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                   Text="{Binding OrderDate}"
                                   FontSize="14"
                                   Foreground="#555"
                                   VerticalAlignment="Center"/>

                            <Border Grid.Column="3"
                                Background="#DCFCE7"
                                CornerRadius="15"
                                Padding="10,4"
                                HorizontalAlignment="Left">

                                <TextBlock Text="{Binding OrderPayet}"
                                       FontWeight="Bold"
                                       Foreground="#15803D"
                                       FontSize="13"/>

                            </Border>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</UserControl>
