@using Models;
@using Models.ViewModel
@model RegitrationViewModel

@{
    ViewData["Title"] = "Registration";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<link href="~/stylesheets/registrationpage.css" rel="stylesheet" />
<form asp-action="RegistrationClient"
      asp-controller="Guest"
      enctype="multipart/form-data"
      method="post"
      class="formRegistration">

    <header class="header">
        <h1 class="page-title">Sign Up</h1>
        <p class="under-page-title">
            Fill in this page to create an account
        </p>
    </header>

    <ul class="fields">

        <li class="fields">
            <input asp-for="Client.ClientFirstName"
                   class="first-name"
                   type="text"
                   placeholder="First Name" />

            <span asp-validation-for="Client.ClientFirstName"
                  class="error-message"></span>

            <input asp-for="Client.ClientLastName"
                   class="last-name"
                   type="text"
                   placeholder="Last Name" />

            <span asp-validation-for="Client.ClientLastName"
                  class="error-message"></span>
        </li>

        <li class="fields">

            <input class="gender"
                   asp-for="Client.ClientGender"
                   type="radio"
                   value="Male" />

            <span class="option">Male</span>

            <input class="gender"
                   asp-for="Client.ClientGender"
                   type="radio"
                   value="Female" />

            <span class="option">Female</span>

            <br />

            <span asp-validation-for="Client.ClientGender"
                  class="error-message"></span>

        </li>

        <li class="fields">

            <input name="file"
                   type="file"
                   accept="image/*" />

            <span asp-validation-for="Client.ClientPicture"
                  class="error-message"></span>

        </li>

        <li class="fields">

            <input asp-for="Client.ClientId"
                   class="id"
                   type="text"
                   placeholder="Id"
                   maxlength="9" />

            <span asp-validation-for="Client.ClientId"
                  class="error-message"></span>

        </li>

        <li class="fields">

            <input asp-for="Client.ClientEmail"
                   class="email"
                   type="email"
                   placeholder="Email" />

            <span asp-validation-for="Client.ClientEmail"
                  class="error-message"></span>

        </li>

        <li class="fields">

            <input asp-for="Client.ClientPassword"
                   class="password"
                   type="password"
                   placeholder="Password" />

            <span asp-validation-for="Client.ClientPassword"
                  class="error-message"></span>

        </li>

        <li class="fields">

            <input asp-for="Client.ClientAdress"
                   class="adress"
                   type="text"
                   placeholder="Address" />

            <span asp-validation-for="Client.ClientAdress"
                  class="error-message"></span>

        </li>

        <li class="fields">

            <select asp-for="Client.CityId"
                    class="city">

                <option value="">*Select City</option>

                @foreach (City city in Model.Cities)
                {
                    <option value="@city.CityId">
                        @city.CityName
                    </option>
                }

            </select>

            <span asp-validation-for="Client.CityId"
                  class="error-message"></span>

        </li>

        <li class="fields buttons-container">

            <button class="button" type="submit">
                Send Request
            </button>


        </li>

    </ul>

</form>