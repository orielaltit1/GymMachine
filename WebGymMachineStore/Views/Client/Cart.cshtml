@using Models;
@model ShoppingCartViewModel;

@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/ClientMasterPage.cshtml";
}
<link href="~/stylesheets/cartpage.css" rel="stylesheet" />
<main class="page">
    <section class="cart">
        <h2>Shopping Cart</h2>
        @if (Model.Machines != null && Model.Machines.Any())
        {
            @foreach(GymMachine gymMachine in Model.Machines)
            {

                <a asp-action="DeleteFromCart" asp-controller="Client"
                   asp-route-machineId="@gymMachine.MachineId"
                   asp-route-orderId="@Model.Order.OrderId">

                    <img src="~/images/trash.png"
                         width="20"
                         height="20" />

                </a>
                    <div class="item">
                    <div class="img">
                        <img src="http://localhost:5138/dataimages/machineimages/@gymMachine.MachineImage"
                             width="100"
                             height="80" />
                    </div>
                    <div class="info">
                        <h4>@gymMachine.MachineName</h4>
                        <p>@gymMachine.MachineDescription</p>
                    </div>
                    <div class="controls">
                        <span class="price">@gymMachine.MachinePrice$</span>
                        <div class="qty-box">
                            <span class="qty">@gymMachine.Amount</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {   
            <div class="empty-cart">
                <h2 class="no-machines-message">Your cart is empty</h2>
                <a href="http://localhost:5086/Guest/MachineCatalog/" class="return-catalog">Return to catalog</a>
            </div>
            
        }

    </section>

    <aside class="summary">
        <h3>Order Summary</h3>
        <div class="line">
            <span>Total</span>
            <span id="total">$@Model.TotalPrice</span>
        </div>
        <form asp-action="CloseCart"
              asp-controller="Client"
              method="post">
              
            <button type="submit" class="checkout">
                Check Out
            </button>

        </form>
        @if (Model.Machines != null && Model.Machines.Any())
        {
            <a href="http://localhost:5086/Guest/MachineCatalog/" class="continue">Continue Shopping</a>
        }
    </aside>
</main>

